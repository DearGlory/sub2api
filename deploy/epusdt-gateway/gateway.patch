+package config
+
+// GetPaymentRateForCoin preserves fixed/USD compatibility but refuses expired
+// automatic quotes at every payment creation and gateway network-selection seam.
+func GetPaymentRateForCoin(coin, base string) float64 {
+	coin, base = normalizeRateKey(coin), normalizeRateKey(base)
+	if GetRateMode() != RateModeAuto || coin == base || (coin == "usdt" && base == "usd") {
+		return GetRateForCoin(coin, base)
+	}
+	snapshot, found := loadRateCacheSnapshot(base)
+	if found && !isRateCacheStale(snapshot, rateNow()) {
+		return rateFromSnapshot(snapshot, coin)
+	}
+	_ = refreshRateBaseForCoin(base, coin, false)
+	snapshot, found = loadRateCacheSnapshot(base)
+	if !found || isRateCacheStale(snapshot, rateNow()) {
+		return 0
+	}
+	return rateFromSnapshot(snapshot, coin)
+}
