+package mq
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/GMWalletApp/epusdt/internal/testutil"
+	"github.com/GMWalletApp/epusdt/model/dao"
+	"github.com/GMWalletApp/epusdt/model/mdb"
+	"github.com/GMWalletApp/epusdt/util/sign"
+)
+
+func TestGmpayChildReceiptKeepsMerchantIdentityAndUsesSettledEvidence(t *testing.T) {
+	cleanup := testutil.SetupTestDatabases(t)
+	defer cleanup()
+	key := &mdb.ApiKey{Name: "child-receipt-test", Pid: "9199", SecretKey: "fixture-only", Status: mdb.ApiKeyStatusEnable}
+	if err := dao.Mdb.Create(key).Error; err != nil {
+		t.Fatal(err)
+	}
+	var received map[string]interface{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer r.Body.Close()
+		_ = json.NewDecoder(r.Body).Decode(&received)
+		_, _ = io.WriteString(w, "ok")
+	}))
+	defer server.Close()
+	parent := &mdb.Orders{TradeId: "parent-trade", OrderId: "merchant-order", Amount: 67, Currency: "CNY", Token: "USDT", ActualAmount: 10, ReceiveAddress: "old-wallet", Network: "tron", Status: mdb.StatusPaySuccess, ApiKeyID: key.ID, PaymentType: mdb.PaymentTypeGmpay, PayProvider: mdb.PaymentProviderOnChain, NotifyUrl: server.URL}
+	if err := dao.Mdb.Create(parent).Error; err != nil {
+		t.Fatal(err)
+	}
+	child := &mdb.Orders{TradeId: "child-trade", OrderId: "child-trade", ParentTradeId: parent.TradeId, Amount: 67, Currency: "CNY", Token: "USDT", ActualAmount: 10.03, ReceiveAddress: "settled-wallet", Network: "ethereum", Status: mdb.StatusPaySuccess, BlockTransactionId: "settled-child-block", ApiKeyID: key.ID, PaymentType: mdb.PaymentTypeGmpay, PayProvider: mdb.PaymentProviderOnChain}
+	if err := dao.Mdb.Create(child).Error; err != nil {
+		t.Fatal(err)
+	}
+	parent.PayBySubId = child.ID
+	if err := dao.Mdb.Model(parent).UpdateColumn("pay_by_sub_id", child.ID).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := sendOrderCallback(parent); err != nil {
+		t.Fatal(err)
+	}
+	if received["trade_id"] != parent.TradeId || received["order_id"] != parent.OrderId {
+		t.Fatalf("merchant association changed: %v", received)
+	}
+	if received["actual_amount"] != child.ActualAmount || received["block_transaction_id"] != child.BlockTransactionId || received["receive_address"] != child.ReceiveAddress {
+		t.Fatalf("callback contains parent placeholders instead of settled child evidence: %v", received)
+	}
+	signature, _ := received["signature"].(string)
+	delete(received, "signature")
+	expected, err := sign.GetHMACSHA256(received, key.SecretKey)
+	if err != nil || signature != expected {
+		t.Fatalf("receipt signature mismatch: %v", err)
+	}
+	var persisted mdb.Orders
+	if err := dao.Mdb.First(&persisted, parent.ID).Error; err != nil {
+		t.Fatal(err)
+	}
+	if persisted.ActualAmount != 10 || persisted.BlockTransactionId != "" {
+		t.Fatal("callback projection mutated parent payment history")
+	}
+}
+
+func TestGmpayChildReceiptRejectsInvalidRelationship(t *testing.T) {
+	for _, bad := range []string{"parent", "merchant", "status", "currency", "amount", "token", "block", "provider"} {
+		t.Run(bad, func(t *testing.T) {
+			cleanup := testutil.SetupTestDatabases(t)
+			defer cleanup()
+			key := &mdb.ApiKey{Name: "key", Pid: "9199", SecretKey: "fixture-only", Status: mdb.ApiKeyStatusEnable}
+			if err := dao.Mdb.Create(key).Error; err != nil {
+				t.Fatal(err)
+			}
+			hits := 0
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { hits++; _, _ = io.WriteString(w, "ok") }))
+			defer server.Close()
+			parent := &mdb.Orders{TradeId: "parent", OrderId: "merchant", Amount: 67, Currency: "CNY", Status: mdb.StatusPaySuccess, ApiKeyID: key.ID, PaymentType: mdb.PaymentTypeGmpay, NotifyUrl: server.URL}
+			if err := dao.Mdb.Create(parent).Error; err != nil {
+				t.Fatal(err)
+			}
+			child := &mdb.Orders{TradeId: "child", OrderId: "child", ParentTradeId: "parent", Amount: 67, Currency: "CNY", Token: "USDT", ActualAmount: 10.03, ReceiveAddress: "wallet", Network: "tron", Status: mdb.StatusPaySuccess, BlockTransactionId: "block", ApiKeyID: key.ID, PaymentType: mdb.PaymentTypeGmpay, PayProvider: mdb.PaymentProviderOnChain}
+			switch bad {
+			case "parent":
+				child.ParentTradeId = "other"
+			case "merchant":
+				child.ApiKeyID = key.ID + 1
+			case "status":
+				child.Status = mdb.StatusWaitPay
+			case "currency":
+				child.Currency = "USD"
+			case "amount":
+				child.Amount = 6.7
+			case "token":
+				child.Token = ""
+			case "block":
+				child.BlockTransactionId = ""
+			case "provider":
+				child.PayProvider = mdb.PaymentProviderOkPay
+			}
+			if err := dao.Mdb.Create(child).Error; err != nil {
+				t.Fatal(err)
+			}
+			parent.PayBySubId = child.ID
+			if err := sendOrderCallback(parent); err == nil {
+				t.Fatal("invalid child was acknowledged")
+			}
+			if hits != 0 {
+				t.Fatal("invalid child was sent to merchant")
+			}
+		})
+	}
+}
