+package mq
+
+import (
+	"errors"
+	"math"
+	"strings"
+
+	"github.com/GMWalletApp/epusdt/model/dao"
+	"github.com/GMWalletApp/epusdt/model/mdb"
+)
+
+// Keep the merchant's order/trade identity while signing the actual settled
+// child's on-chain evidence. Parent history remains unchanged in the database.
+func settledGmpayReceiptOrder(parent *mdb.Orders) (*mdb.Orders, error) {
+	if parent == nil {
+		return nil, errors.New("GMPay callback order is missing")
+	}
+	if parent.PayBySubId == 0 {
+		return parent, nil
+	}
+	if parent.Status != mdb.StatusPaySuccess || parent.ParentTradeId != "" || parent.ApiKeyID == 0 {
+		return nil, errors.New("GMPay callback parent is invalid")
+	}
+	var child mdb.Orders
+	if err := dao.Mdb.First(&child, parent.PayBySubId).Error; err != nil {
+		return nil, err
+	}
+	if child.ID == parent.ID || child.ParentTradeId != parent.TradeId || child.ApiKeyID != parent.ApiKeyID || child.Status != mdb.StatusPaySuccess || child.PayBySubId != 0 {
+		return nil, errors.New("GMPay callback child relationship is invalid")
+	}
+	if child.Amount != parent.Amount || child.Amount <= 0 || math.IsNaN(child.Amount) || math.IsInf(child.Amount, 0) || !strings.EqualFold(child.Currency, parent.Currency) || child.PaymentType != parent.PaymentType {
+		return nil, errors.New("GMPay callback child payment identity differs")
+	}
+	if child.PayProvider != mdb.PaymentProviderOnChain || child.ActualAmount <= 0 || math.IsNaN(child.ActualAmount) || math.IsInf(child.ActualAmount, 0) || strings.TrimSpace(child.Token) == "" || strings.TrimSpace(child.Network) == "" || strings.TrimSpace(child.ReceiveAddress) == "" || strings.TrimSpace(child.BlockTransactionId) == "" {
+		return nil, errors.New("GMPay callback child lacks on-chain payment evidence")
+	}
+	return &child, nil
+}
